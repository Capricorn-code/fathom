{
  "name": "@haruto-y/fathom",
  "version": "0.1.0",
  "description": "Claude Codeのセッションログから「何をやったか」を言語化するローカルCLI。指示とAIの応答を5分で読めるサマリ(MD/HTML)にする",
  "keywords": [
    "claude-code",
    "claude",
    "cli",
    "summary",
    "session-log",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Capricorn-code/fathom.git"
  },
  "type": "module",
  "bin": {
    "fathom": "./dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fathom/core": "workspace:*"
  }
}
